{
  "name": "sanguo-graph",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "A source-traceable knowledge graph for historical relationships in the Three Kingdoms period.",
  "license": "MIT",
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:offline": "tsc -b && vite build --config vite.standalone.config.ts --mode offline",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "audit:relations": "tsx scripts/audit-relation-coverage.ts",
    "validate:data": "tsx scripts/validate-data.ts",
    "validate:relation-coverage": "tsx scripts/audit-relation-coverage.ts --check",
    "validate:processed": "tsx scripts/validate-processed.ts",
    "validate:offline": "tsx scripts/validate-offline.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "cytoscape": "3.33.1",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@types/node": "18.19.130",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.3.4",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "5.1.0",
    "eslint-plugin-react-refresh": "0.4.16",
    "globals": "15.15.0",
    "jsdom": "25.0.1",
    "tsx": "4.20.6",
    "typescript": "5.7.3",
    "typescript-eslint": "8.65.0",
    "vite": "6.4.3",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "3.2.7"
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/sanguo/schemas/persons.schema.json",
  "title": "Three Kingdoms persons dataset",
  "type": "array",
  "items": {
    "$ref": "#/$defs/person"
  },
  "$defs": {
    "citation": {
      "type": "object",
      "required": [
        "dataset_id",
        "record_id",
        "url"
      ],
      "properties": {
        "dataset_id": {
          "type": "string",
          "minLength": 1
        },
        "record_id": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "locator": {
          "type": "string"
        },
        "note": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "person": {
      "type": "object",
      "required": [
        "id",
        "name_zh",
        "aliases",
        "courtesy_name",
        "birth_year",
        "death_year",
        "faction",
        "wikidata_id",
        "sources"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^person:wd:Q[1-9][0-9]*$"
        },
        "name_zh": {
          "type": "string",
          "minLength": 1
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "courtesy_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "birth_year": {
          "type": [
            "integer",
            "null"
          ]
        },
        "death_year": {
          "type": [
            "integer",
            "null"
          ]
        },
        "faction": {
          "type": [
            "string",
            "null"
          ]
        },
        "wikidata_id": {
          "type": "string",
          "pattern": "^Q[1-9][0-9]*$"
        },
        "family_roots": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^Q[1-9][0-9]*$"
          },
          "uniqueItems": true
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/citation"
          }
        }
      },
      "additionalProperties": false
    }
  }
}

